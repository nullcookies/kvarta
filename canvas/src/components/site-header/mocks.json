            "label": "Подписка",
            "link": "/#subscription"
          }
        },
        "nav-delivery": {
          "type": "nav-link",
          "props": {
            "label": "Доставка",
            "link": "/#delivery"
          }
        },
        "nav-contacts": {
          "type": "nav-link",
          "props": {
            "label": "Контакты",
            "link": "/#lead"
          }
        }
      }
